{
  "name": "dom",
  "initializeCommand": "ln -sf ../.env .devcontainer/.env",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/dom",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "uv sync --all-packages --project /workspaces/dom/server",
  "customizations": {
    "zed": { "extensions": ["toml", "dockerfile"] },
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
